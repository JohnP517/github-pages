<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily News</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      margin: 0;
      padding: 0;
    }

    header {
      background-color: #333;
      color: white;
      padding: 1rem;
      text-align: center;
    }

    .news-container {
      max-width: 800px;
      margin: 2rem auto;
      background: white;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .news-item {
      margin-bottom: 1.5rem;
    }

    .news-item h2 {
      color: #333;
    }

    .news-item p {
      color: #666;
    }
  </style>
</head>
<body>
  <header>
    <h1>Today's News</h1>
  </header>

  <div class="news-container">
    <div class="news-item">
      <h2>Headline 1</h2>
      <p>This is a summary of the first news item.</p>
    </div>
    <div class="news-item">
      <h2>Headline 2</h2>
      <p>This is a summary of the second news item.</p>
    </div>
  </div>
</body>
</html>
